MONGO_URI=mongodb://localhost:27017/transitops_dev
# Atlas prod example: mongodb+srv://USER:PASS@cluster.mongodb.net/transitops?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=your_jwt_secret_key_here
# Dev: http://localhost:5173 | Prod (Render): https://transitops-han.vercel.app
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Password policy enforcement (set to false once all users have compliant passwords)
PASSWORD_POLICY_ENFORCEMENT=true

# SMTP Configuration (e.g., Resend, SendGrid)
# Required in production. In development, if omitted, Ethereal test mail is used
# and the forgot-password API returns a preview URL link.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_smtp_password_here
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=TransitOps
